# =============================================================================
# Terraform Variables — Example Configuration
# =============================================================================
# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is in .gitignore and must never be committed.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================


# AWS region to deploy all resources into.
aws_region = "us-east-1"

# Base name used for all AWS resources (S3 buckets, Lambda functions, IAM roles, etc.).
# Must be globally unique for S3 bucket naming — use a name specific to your project.
project_name = "your-project-name"

# WAF Web ACL ARN attached to your CloudFront distribution.
# Find this in AWS Console → WAF & Shield → Web ACLs (set region to Global/CloudFront).
# If your distribution was created with a WAF subscription plan, this is required —
# AWS will reject any attempt to remove the WAF from that distribution.
cloudfront_waf_arn = "arn:aws:wafv2:us-east-1:YOUR_ACCOUNT_ID:global/webacl/YOUR_WEBACL_NAME/YOUR_WEBACL_ID"

# Lambda layer ARNs for the imageValidator function (Pillow, OpenCV, filetype).
# imageValidator runs python3.12 on arm64, so the layer must match both.
# Public collections such as KLayers don't publish these packages for arm64,
# so build a single consolidated layer containing Pillow, opencv-python-headless,
# and filetype:
#   pip install --platform manylinux2014_aarch64 --python-version 3.12
#       --implementation cp --only-binary=:all: -t python/ pillow opencv-python-headless filetype
# The zip is ~65 MB, so publish it via S3 (--content S3Bucket=...,S3Key=...)
# with --compatible-architectures arm64.
# Full steps: README.md → Deployment → Step 2 — Lambda layers.
validator_layer_arns = [
  "arn:aws:lambda:REGION:ACCOUNT_ID:layer:YOUR_ARM64_LAYER:VERSION",
]

# Optional: custom domain for the frontend CloudFront distribution.
# Requesting/validating the ACM cert (us-east-1, DNS validation) is handled by
# terraform/acm.tf. If your DNS isn't in Route 53, add the validation CNAME from
# `terraform output frontend_domain_validation` manually at your registrar, then
# apply again — CloudFront won't pick up the alias until the cert is issued.
# Defaults to "" (unset); leave commented out to use the default CloudFront
# domain (no alias/cert) instead. When set, it's also added to the S3 and
# API Gateway CORS allowed origins.
# frontend_domain = "your.custom-domain.com"
